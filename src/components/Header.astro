---
const pathname = Astro.url.pathname;
const links = [
  { href: '/#articles', label: 'Articles', activePrefix: '/writing/' },
  { href: '/talks/', label: 'Talks' },
  { href: '/books/', label: 'Books' },
  { href: '/about/', label: 'About' },
];

const isActive = (link: (typeof links)[number]) =>
  link.activePrefix ? pathname.startsWith(link.activePrefix) : pathname.startsWith(link.href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Paul Bakker, home">
      <span class="wordmark-mark" aria-hidden="true">PB</span>
      <span>Paul Bakker</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
